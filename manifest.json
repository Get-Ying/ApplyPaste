{
  "manifest_version": 3,
  "name": "ApplyPaste",
  "short_name": "ApplyPaste",
  "version": "0.1.0",
  "description": "ApplyPaste is a local application form helper for reusable answers, attachments, records, and settings.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "clipboardWrite", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["https://open.feishu.cn/*"],
  "icons": {
    "16": "icons/job-paste-16.png",
    "32": "icons/job-paste-32.png",
    "48": "icons/job-paste-48.png",
    "128": "icons/job-paste-128.png"
  },
  "action": {
    "default_title": "ApplyPaste",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/job-paste-16.png",
      "32": "icons/job-paste-32.png",
      "48": "icons/job-paste-48.png",
      "128": "icons/job-paste-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
